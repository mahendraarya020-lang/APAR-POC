@model List<InspectionAnswer>
@{ ViewData["Title"] = "Tindak lanjut"; }
<div class="page-heading"><div><p class="eyebrow">PENANGANAN TEMUAN</p><h1>Tindak lanjut</h1><p>Catat perkembangan untuk setiap butir yang perlu tindakan.</p></div></div>
@if (Model.Count == 0) { <div class="empty-state"><h2>Tidak ada temuan</h2><p>Temuan inspeksi akan muncul di sini.</p></div> }
@foreach (var a in Model) { var latest = a.FollowUps.OrderByDescending(x => x.CreatedAt).FirstOrDefault(); <article class="surface finding-card"><div><span class="code-pill">@a.Inspection.Equipment.Code</span><h2>@a.Item.Question</h2><p>@a.Inspection.Equipment.Name · @a.Inspection.Equipment.Building.Name</p><p>Catatan inspeksi: <strong>@a.Note</strong></p><p>Status: <span class="@(latest?.Status == "Selesai" ? "badge-soft" : "badge-find")">@(latest?.Status ?? "Terbuka")</span></p>@if (latest != null) { <p>Terakhir: @latest.Note</p> }</div><form asp-action="Create" method="post" class="follow-form"><input type="hidden" name="inspectionAnswerId" value="@a.Id" /><label class="form-label" for="note-@a.Id">Catatan tindak lanjut</label><textarea class="form-control" id="note-@a.Id" name="note" rows="2" required maxlength="1000"></textarea><label class="form-label mt-2" for="status-@a.Id">Status</label><select class="form-select" id="status-@a.Id" name="status"><option value="Terbuka">Terbuka</option><option value="DalamProses">Dalam proses</option><option value="Selesai">Selesai</option></select><button class="btn btn-accent mt-3" type="submit">Simpan catatan</button></form></article> }
