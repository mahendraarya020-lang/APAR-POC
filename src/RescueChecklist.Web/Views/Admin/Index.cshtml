@{ ViewData["Title"] = "Administrasi"; var buildings = (List<Building>)ViewBag.Buildings; var equipment = (List<Equipment>)ViewBag.Equipment; var templates = (List<ChecklistTemplate>)ViewBag.Templates; var users = (List<ApplicationUser>)ViewBag.Users; var roles = (Dictionary<string,string>)ViewBag.UserRoles; }
<div class="page-heading"><div><p class="eyebrow">PENGELOLAAN DATA</p><h1>Administrasi</h1><p>Atur pengguna, gedung, peralatan, dan versi checklist.</p></div></div>
<div class="admin-grid"><section class="surface"><h2>Gedung</h2><form asp-action="Building" method="post" class="stack-form"><label class="form-label" for="building-code">Kode</label><input class="form-control" id="building-code" name="code" required maxlength="30" /><label class="form-label" id="building-name-label" for="building-name">Nama gedung</label><input class="form-control" id="building-name" name="name" required maxlength="120" /><button class="btn btn-accent" type="submit">Tambah gedung</button></form><div class="admin-list">@foreach (var b in buildings) { <div><span><strong>@b.Code</strong> Â· @b.Name <small>@(b.IsActive ? "Aktif" : "Nonaktif")</small></span><form asp-action="ToggleBuilding" method="post"><input type="hidden" name="id" value="@b.Id" /><button class="text-button" type="submit">@(b.IsActive ? "Nonaktifkan" : "Aktifkan")</button></form></div> }</div></section>
<section class="surface"><h2>Peralatan</h2><form asp-action="Equipment" method="post" class="stack-form"><label class="form-label" for="equipment-building">Gedung</label><select class="form-select" id="equipment-building" name="buildingId" required>@foreach (var b in buildings.Where(x => x.IsActive)) { <option value="@b.Id">@b.Name</option> }</select><label class="form-label" for="equipment-code">Kode</label><input class="form-control" id="equipment-code" name="code" required maxlength="30" /><label class="form-label" for="equipment-name">Nama peralatan</label><input class="form-control" id="equipment-name" name="name" required maxlength="120" /><button class="btn btn-accent" type="submit">Tambah peralatan</button></form><div class="admin-list">@foreach (var e in equipment) { <div><span><strong>@e.Code</strong> Â· @e.Name <small>@e.Building.Name Â· @(e.IsActive ? "Aktif" : "Nonaktif")</small></span><form asp-action="ToggleEquipment" method="post"><input type="hidden" name="id" value="@e.Id" /><button class="text-button" type="submit">@(e.IsActive ? "Nonaktifkan" : "Aktifkan")</button></form></div> }</div></section>
<section class="surface"><h2>Checklist</h2><p>Setiap perubahan membuat versi baru; hasil lama tetap memakai versi sebelumnya.</p><form asp-action="Template" method="post" class="stack-form"><label class="form-label" for="template-name">Nama template</label><input class="form-control" id="template-name" name="name" required maxlength="120" /><label class="form-label" for="questions">Butir checklist <small>(satu per baris, minimal tiga)</small></label><textarea class="form-control" id="questions" name="questions" rows="5" required></textarea><button class="btn btn-accent" type="submit">Buat versi aktif</button></form><div class="admin-list">@foreach (var t in templates) { <div><span><strong>@t.Name</strong> v@(t.Version) <small>@t.Items.Count butir Â· @(t.IsActive ? "Aktif" : "Arsip")</small></span></div> }</div></section>
<section class="surface"><h2>Pengguna</h2><form asp-action="UserAccount" method="post" class="stack-form"><label class="form-label" for="user-name">Nama pengguna</label><input class="form-control" id="user-name" name="userName" required /><label class="form-label" for="display-name">Nama tampilan</label><input class="form-control" id="display-name" name="displayName" required maxlength="100" /><label class="form-label" for="new-password">Kata sandi awal</label><input type="password" class="form-control" id="new-password" name="password" required minlength="10" autocomplete="new-password" /><label class="form-label" for="role">Peran</label><select class="form-select" id="role" name="role"><option>Rescue</option><option>PICBuilding</option><option>Management</option><option>Admin</option></select><label class="form-label" for="user-building">Akses gedung</label><select class="form-select" id="user-building" name="buildingId"><option value="">Pilih untuk selain Admin</option>@foreach (var b in buildings.Where(x => x.IsActive)) { <option value="@b.Id">@b.Name</option> }</select><button class="btn btn-accent" type="submit">Tambah pengguna</button></form><div class="admin-list">@foreach (var u in users) { <div><span><strong>@u.UserName</strong> Â· @u.DisplayName ? @roles.GetValueOrDefault(u.Id) <small>@(u.IsActive ? "Aktif" : "Nonaktif") Â· @string.Join(", ", u.BuildingAccesses.Select(x => x.Building.Name))</small></span><form asp-action="ToggleUser" method="post"><input type="hidden" name="id" value="@u.Id" /><button class="text-button" type="submit">@(u.IsActive ? "Nonaktifkan" : "Aktifkan")</button></form></div> }</div><form asp-action="AssignBuilding" method="post" class="stack-form mt-4"><h3>Tambah akses gedung</h3><select class="form-select" name="userId" aria-label="Pengguna">@foreach (var u in users) { <option value="@u.Id">@u.UserName</option> }</select><select class="form-select" name="buildingId" aria-label="Gedung">@foreach (var b in buildings) { <option value="@b.Id">@b.Name</option> }</select><button class="btn btn-outline-dark" type="submit">Tambahkan akses</button></form></section></div>


<section class="surface mt-4">
    <h2>Ubah peran dan akses gedung</h2>
    <div class="admin-grid">
        <form asp-action="ChangeRole" method="post" class="stack-form">
            <label class="form-label" for="change-user">Pengguna</label>
            <select class="form-select" id="change-user" name="userId">@foreach (var u in users) { <option value="@u.Id">@u.UserName (@roles.GetValueOrDefault(u.Id))</option> }</select>
            <label class="form-label" for="change-role">Peran baru</label>
            <select class="form-select" id="change-role" name="role"><option>Rescue</option><option>PICBuilding</option><option>Management</option><option>Admin</option></select>
            <button type="submit" class="btn btn-outline-dark">Simpan peran</button>
        </form>
        <form asp-action="RevokeBuilding" method="post" class="stack-form">
            <label class="form-label" for="revoke-user">Pengguna</label>
            <select class="form-select" id="revoke-user" name="userId">@foreach (var u in users) { <option value="@u.Id">@u.UserName</option> }</select>
            <label class="form-label" for="revoke-building">Gedung</label>
            <select class="form-select" id="revoke-building" name="buildingId">@foreach (var b in buildings) { <option value="@b.Id">@b.Name</option> }</select>
            <button type="submit" class="btn btn-outline-dark">Cabut akses gedung</button>
        </form>
    </div>
</section>
