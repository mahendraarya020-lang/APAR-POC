@model List<Equipment>
@{ ViewData["Title"] = "Peralatan"; var buildings = (List<Building>)ViewBag.Buildings; }
<div class="page-heading"><div><p class="eyebrow">INVENTARIS RESCUE</p><h1>Peralatan</h1><p>Pilih unit yang akan diperiksa.</p></div></div>
<form method="get" class="filter-row surface"><div><label for="q" class="form-label">Cari peralatan</label><input id="q" name="q" class="form-control" value="@ViewBag.Query" placeholder="Kode atau nama" /></div><div><label for="buildingId" class="form-label">Gedung</label><select id="buildingId" name="buildingId" class="form-select"><option value="">Semua gedung</option>@foreach (var b in buildings) { <option value="@b.Id" selected="@(ViewBag.BuildingId == b.Id)">@b.Name</option> }</select></div><button type="submit" class="btn btn-dark">Terapkan</button></form>
<div class="equipment-grid">@foreach (var x in Model) { <article class="equipment-card"><div class="equipment-card-top"><span class="code-pill">@x.Code</span><span class="status-dot">Aktif</span></div><h2>@x.Name</h2><p>@x.Building.Name</p><div class="card-actions">@if (User.IsInRole(Roles.Admin) || User.IsInRole(Roles.Rescue)) { <a class="btn btn-accent" asp-controller="Inspections" asp-action="Create" asp-route-equipmentId="@x.Id">Mulai inspeksi</a> }<a asp-controller="Inspections" asp-action="Index" asp-route-buildingId="@x.BuildingId">Riwayat gedung →</a></div></article> }</div>
@if (Model.Count == 0) { <div class="empty-state"><h2>Peralatan tidak ditemukan</h2><p>Ubah kata kunci atau filter gedung.</p></div> }
