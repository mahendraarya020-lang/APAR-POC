@model List<ReportRow>
@{ ViewData["Title"] = "Laporan"; var buildings = (List<Building>)ViewBag.Buildings; }
<div class="page-heading"><div><p class="eyebrow">RINGKASAN DATA</p><h1>Laporan</h1><p>Jumlah inspeksi dan temuan menurut gedung dan periode.</p></div><a class="btn btn-accent" href="/Reports/Export.csv?buildingId=@ViewBag.BuildingId&from=@ViewBag.From&to=@ViewBag.To">Unduh CSV</a></div>
<form method="get" class="filter-row surface"><div><label class="form-label" for="buildingId">Gedung</label><select class="form-select" id="buildingId" name="buildingId"><option value="">Semua gedung</option>@foreach (var b in buildings) { <option value="@b.Id" selected="@(ViewBag.BuildingId == b.Id)">@b.Name</option> }</select></div><div><label class="form-label" for="from">Dari</label><input class="form-control" type="date" id="from" name="from" value="@ViewBag.From" /></div><div><label class="form-label" for="to">Sampai</label><input class="form-control" type="date" id="to" name="to" value="@ViewBag.To" /></div><button class="btn btn-dark" type="submit">Terapkan</button></form>
<section class="surface"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Gedung</th><th>Inspeksi</th><th>Temuan</th></tr></thead><tbody>@foreach (var row in Model) { <tr><td><strong>@row.Building</strong></td><td>@row.Inspections</td><td>@row.Findings</td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p class="empty-inline">Belum ada data untuk filter ini.</p> }</section>
