@model List<Inspection>
@{ ViewData["Title"] = "Riwayat inspeksi"; var buildings = (List<Building>)ViewBag.Buildings; }
<div class="page-heading"><div><p class="eyebrow">ARSIP PEMERIKSAAN</p><h1>Riwayat inspeksi</h1><p>Hasil terkirim bersifat tetap dan dapat ditelusuri.</p></div></div>
<form method="get" class="filter-row surface"><div><label class="form-label" for="buildingId">Gedung</label><select class="form-select" id="buildingId" name="buildingId"><option value="">Semua gedung</option>@foreach (var b in buildings) { <option value="@b.Id" selected="@(ViewBag.BuildingId == b.Id)">@b.Name</option> }</select></div><div><label class="form-label" for="from">Dari</label><input class="form-control" type="date" id="from" name="from" value="@ViewBag.From" /></div><div><label class="form-label" for="to">Sampai</label><input class="form-control" type="date" id="to" name="to" value="@ViewBag.To" /></div><button class="btn btn-dark" type="submit">Terapkan</button></form>
<section class="surface"><div class="table-responsive"><table class="table app-table"><thead><tr><th>Waktu (UTC)</th><th>Peralatan</th><th>Gedung</th><th>Petugas</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var x in Model) { <tr><td>@x.SubmittedAt.ToString("dd MMM yyyy HH:mm")</td><td><strong>@x.Equipment.Name</strong><small>@x.Equipment.Code</small></td><td>@x.Equipment.Building.Name</td><td>@x.Inspector.DisplayName</td><td><span class="badge-soft">@x.Status</span></td><td><a asp-action="Details" asp-route-id="@x.Id">Detail</a></td></tr> }</tbody></table></div>@if (Model.Count == 0) { <p class="empty-inline">Belum ada inspeksi untuk filter ini.</p> }</section>
