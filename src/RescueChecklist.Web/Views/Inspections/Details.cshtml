@model Inspection
@{ ViewData["Title"] = "Detail inspeksi"; }
<div class="page-heading"><div><p class="eyebrow">HASIL PEMERIKSAAN #@Model.Id</p><h1>@Model.Equipment.Name</h1><p>@Model.Equipment.Building.Name · @Model.Equipment.Code</p></div><a asp-action="Index" class="btn btn-outline-dark">Kembali ke riwayat</a></div>
<div class="detail-meta surface"><div><span>Pelaksana</span><strong>@Model.Inspector.DisplayName</strong></div><div><span>Waktu kirim (UTC)</span><strong>@Model.SubmittedAt.ToString("dd MMM yyyy HH:mm")</strong></div><div><span>Versi checklist</span><strong>v@(Model.TemplateVersion)</strong></div><div><span>Status sinkronisasi</span><strong>@Model.Status</strong></div></div>
<section class="surface"><h2 class="mb-4">Jawaban checklist</h2>@foreach (var a in Model.Answers.OrderBy(x => x.Item.Order)) { <div class="answer-row"><div><span class="question-number">@a.Item.Order.ToString("00")</span><strong>@a.Item.Question</strong>@if (!string.IsNullOrWhiteSpace(a.Note)) { <p>Catatan: @a.Note</p> }@foreach (var f in a.FollowUps.OrderByDescending(x => x.CreatedAt)) { <p class="follow-note">@f.Status · @f.Note <small>— @f.Author.DisplayName, @f.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</small></p> }</div><span class="@(a.Result == "PerluTindakan" ? "badge-find" : "badge-soft")">@(a.Result == "PerluTindakan" ? "Perlu tindakan" : a.Result == "TidakBerlaku" ? "Tidak berlaku" : "Baik")</span></div> }</section>
